{
  "name": "fusion-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:frontend": "pnpm --filter @sg-reports/frontend dev",
    "dev:backend": "pnpm --filter @sg-reports/backend dev",
    "build": "pnpm --filter @sg-reports/frontend build && pnpm --filter @sg-reports/backend build",
    "build:client": "pnpm --filter @sg-reports/frontend build",
    "build:server": "pnpm --filter @sg-reports/backend build",
    "start": "pnpm --filter @sg-reports/backend start",
    "test": "pnpm --filter @sg-reports/frontend test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
